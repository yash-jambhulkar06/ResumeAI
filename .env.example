# --------------------------------------------------
# ResumeAI Environment Variables
# --------------------------------------------------

# Django Settings
DJANGO_SECRET_KEY=django-insecure-development-only-key-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Groq LLM API Key (Get yours at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Database (Leave empty for local SQLite db.sqlite3)
# DATABASE_URL=postgres://user:password@host:port/dbname

# OCR (Optional for image resume extraction on Windows)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# CSRF (Required for production deployment like Render)
# CSRF_TRUSTED_ORIGINS=https://resumeai-zwez.onrender.com
